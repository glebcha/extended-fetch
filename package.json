{
  "name": "extended-fetch",
  "version": "3.0.0",
  "description": "Extended http client based on fetch",
  "main": "build/umd/extended-fetch.umd.js",
  "module": "build/es/index.js",
  "types": "build/es/index.d.ts",
  "browser": "build/umd/extended-fetch.umd.js",
  "files": [
    "build",
    "!build/**/tsconfig.*",
    "README.md"
  ],
  "scripts": {
    "build": "npm run build:clean && rolldown -c && npm run types:emit && npm run types:copy",
    "build:clean": "node build-utils/clean-build.mjs",
    "proxy": "rolldown -c --watch",
    "prepublishOnly": "npm run build",
    "lint": "biome lint .",
    "fix": "biome lint --write .",
    "format": "biome format . --write && git update-index --again",
    "test": "uvu -r esbuild-register src spec",
    "types:sync": "npx typesync && npm i",
    "types:check": "tsc --noEmit --project tsconfig.json",
    "types:copy": "node build-utils/copy-declarations.mjs",
    "types:emit": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/glebcha/extended-fetch.git"
  },
  "keywords": [
    "fetch",
    "axios",
    "middleware",
    "node-fetch"
  ],
  "author": "Glebcha",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/core-js": "^2.5.8",
    "@types/node": "^22.9.1",
    "cross-fetch": "^4.0.0",
    "esbuild": "^0.24.0",
    "esbuild-register": "^3.6.0",
    "lefthook": "^1.8.4",
    "msw": "^2.15.0",
    "prettier": "^3.3.3",
    "rolldown": "^1.2.0",
    "typescript": "^7.0.2",
    "uvu": "^0.5.6"
  }
}
